<% layout("/layouts/boilerplate") %>

<section class="hero">
    <div class="hero-content">
        <span class="section-tag">StaySphere · Stay local</span>
        <h1>Find a stay that feels like yours</h1>
        <p>
            Explore distinctive homes, compare prices, save your favorites,
            and find local dining ideas for your next trip.
        </p>
        <div class="d-flex flex-wrap justify-content-center gap-3">
            <a href="/listings" class="btn btn-danger btn-lg">Explore stays</a>
            <a href="/restaurants" class="btn btn-outline-light btn-lg">Explore restaurants</a>
        </div>
    </div>
</section>

<section class="home-discovery mt-5">
    <div>
        <span class="section-tag">Plan your next trip</span>
        <h2 class="page-title">More than a place to sleep</h2>
        <p class="page-subtitle">
            Browse by stay type, narrow down by budget, and discover curated
            restaurant ideas in Goa, Manali, and Jaipur.
        </p>
    </div>
    <div class="row g-4 mt-2">
        <div class="col-md-6">
            <a class="home-feature-card" href="/listings">
                <span aria-hidden="true">⌕</span>
                <div>
                    <h3>Find your next stay</h3>
                    <p>Search destinations, filter by price, and sort listings.</p>
                </div>
                <i class="fa-solid fa-arrow-right" aria-hidden="true"></i>
            </a>
        </div>
        <div class="col-md-6">
            <a class="home-feature-card" href="/restaurants">
                <span aria-hidden="true">🍽️</span>
                <div>
                    <h3>Explore local dining</h3>
                    <p>Browse curated restaurant suggestions by destination.</p>
                </div>
                <i class="fa-solid fa-arrow-right" aria-hidden="true"></i>
            </a>
        </div>
    </div>
</section>
